# Copy to .env.local and adjust as needed.

# Data source for the app's service facades:
#   mock -> src/services/mock/*  (default; fully runnable with no backend)
#   api  -> real backend via src/services/api/*
VITE_DATA_SOURCE=mock

# Per-service base URLs. Leave BLANK to use the Vite dev proxy
# (/api/<service> -> the port in src/services/api/config.js). Set an absolute
# URL only for a deployed backend or a gateway.
# VITE_AUTHENTICATION_API_URL=
# VITE_CONTENT_API_URL=
# VITE_COMMUNITY_API_URL=
# VITE_LIBRARY_API_URL=
# VITE_MODERATION_API_URL=
# VITE_NOTIFICATION_API_URL=

# NOTE: the backend currently has no CORS config and no API gateway. In dev the
# Vite proxy handles that; a deployed setup needs CORS or a gateway added on the
# backend (story-be work).
